menu "Quad IP-KVM Configuration"

    config TC358743_INIT
        bool "Initialize TC358743 on startup"
        default n
        help
            Enable this to initialize the TC358743 HDMI-CSI bridge during app_main.
            Requires proper I2C connections on the hardware.

    config FRAME_HUB_POOL_SIZE
        int "Frame Hub pool size"
        default 3
        range 2 32
        help
            Number of frame buffers in the pool.

    config FRAME_HUB_MAX_FRAME_KB
        int "Frame Hub max frame size in KB"
        default 256 if FRAME_HUB_PREFER_SPIRAM
        default 64
        range 1 4096
        help
            PSRAM が有効な既定では 256KB（1080p の MJPEG 1 枚の目安）。PSRAM が無いときは内蔵 RAM に収まる 64KB

    config FRAME_HUB_PREFER_SPIRAM
        bool "Prefer SPIRAM for Frame Hub buffers"
        default y
        depends on SPIRAM
        help
            If enabled, attempts to allocate frame buffers from SPIRAM first.
            Falls back to internal RAM if SPIRAM allocation fails.


    config WEB_SERVER_ENABLE
        bool "Enable HTTPS Web Server"
        default n
        help
            Enable the embedded HTTPS web server for management and KVM view.

    config WEB_SERVER_ALLOWED_HOSTS
        string "Allowed Host Header (comma separated)"
        default "quad-ipkvm.local"

    config WEB_SERVER_PBKDF2_ITERATIONS
        int "PBKDF2 Iterations"
        default 10000
        range 10000 100000
        help
            The number of PBKDF2 iterations to use for the login password.

    config WEB_SERVER_CERT_TASK_STACK_SIZE
        int "Web Server Certificate Generation Task Stack Size"
        default 16384
        range 8192 32768
        help
            Stack size for the temporary task that generates the X.509 certificate.
            Generation via PSA Crypto API requires significant stack space.
    config WEB_SERVER_PBKDF2_TASK_STACK_SIZE
        int "Web Server PBKDF2 Task Stack Size"
        default 8192
        range 4096 32768
        help
            Stack size for the worker task that computes PBKDF2 hashes.
            Needs enough for mbedTLS PBKDF2 context.

    config WEB_SERVER_WS_MAX_CLIENTS
        int "Max simultaneous WS clients"
        default 2
        range 1 8
        help
            Maximum number of simultaneous WebSocket video viewers (WS /video).
            Each client is sent from the single httpd task, so keep this small.

    config WEB_SERVER_WS_TICK_MS
        int "WS Tick interval (ms)"
        default 20
        range 5 200
        help
            Interval at which the ws_video task offers the latest frame to each client.

    config WEB_SERVER_WS_TASK_STACK_SIZE
        int "WS Task Stack Size"
        default 4096
        range 2048 16384
        help
            Stack size in bytes of the ws_video task.
            TODO(hw-verify): confirm the stack high water mark on the device.

    config WEB_SERVER_SEND_WAIT_TIMEOUT
        int "WS Send wait timeout (s)"
        default 2
        range 1 10
        help
            send_wait_timeout of the HTTPS server. WebSocket frames are sent inside the httpd task,
            so a stalled client blocks the whole HTTP server for up to this many seconds per send.
            TODO(hw-verify): measure the stall with a slow client.
endmenu
