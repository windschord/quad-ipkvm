menu "Quad IP-KVM Configuration"

    config TC358743_INIT
        bool "Initialize TC358743 on startup"
        default n
        help
            Enable this to initialize the TC358743 HDMI-CSI bridge during app_main.
            Requires proper I2C connections on the hardware.

    config FRAME_HUB_POOL_SIZE
        int "Frame Hub pool size"
        default 3
        range 2 32
        help
            Number of frame buffers in the pool.

    config FRAME_HUB_MAX_FRAME_KB
        int "Frame Hub max frame size in KB"
        default 64
        range 1 4096
        help
            Max frame size in KB. Test pattern JPEG is about 7KB. Real captures (1080p MJPEG)
            will be larger. Increase this once PSRAM is enabled.

    config FRAME_HUB_PREFER_SPIRAM
        bool "Prefer SPIRAM for Frame Hub buffers"
        default n
        depends on SPIRAM
        help
            If enabled, attempts to allocate frame buffers from SPIRAM first.
            Falls back to internal RAM if SPIRAM allocation fails.

endmenu
