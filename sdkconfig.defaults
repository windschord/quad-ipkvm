# Target ESP32-P4
CONFIG_IDF_TARGET="esp32p4"

# Set minimum revision to rev v1.0 (ESP32-P4 v1.3 falls under this v1.x category)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

CONFIG_SPIRAM=y
# TODO(hw-verify): 負荷時（映像バッファの連続書き込み、Ethernet、JPEG）の 200MHz の安定性は未確認
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_PK_WRITE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_WEB_SERVER_ENABLE=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_QUEUE_WORK_BLOCKING=n
