    choice KVM_BOARD_LED_POLARITY
        prompt "KVM LED sense polarity"
        default KVM_BOARD_LED_POLARITY_UNSET
        depends on KVM_BOARD_ENABLE
        help
            Wait for docs/HW_VERIFY.md A6 measurement on the KVM PCB before selecting
            ACTIVE_LOW or ACTIVE_HIGH. Leaving this UNSET fails runtime init closed
            while keeping CI Kconfig builds non-interactive.
            TODO(hw-verify)

        config KVM_BOARD_LED_POLARITY_UNSET
            bool "Unset (fail-closed until HW_VERIFY A6 is measured)"

        config KVM_BOARD_LED_POLARITY_ACTIVE_LOW
            bool "Active-low (0 = lit)"

        config KVM_BOARD_LED_POLARITY_ACTIVE_HIGH
            bool "Active-high (1 = lit)"
    endchoice

    config KVM_BOARD_ALLOW_JTAG_INPUTS
        bool "Allow JTAG GPIOs (GPIO2..5) for KVM LED inputs only"
        default n
        depends on KVM_BOARD_ENABLE
        help
            Leave disabled unless P1 pin budget requires reusing JTAG pins as LED inputs.
            JTAG pins are always rejected for 74HC139 outputs (A0/A1/E_*).
            TODO(hw-verify)

    config KVM_BOARD_HARD_MAX_POWER_MS
        int "Hardware timer hard cap for ATX POWER press (ms)"
        default 500
        range 1 500
        depends on KVM_BOARD_ENABLE
        help
            Board-level GPTimer upper bound for POWER short press (capped at KVM_ATX_HARD_MAX_POWER_MS=500).
            TODO(hw-verify)

    config KVM_BOARD_HARD_MAX_RESET_MS
        int "Hardware timer hard cap for ATX RESET press (ms)"
        default 200
        range 1 200
        depends on KVM_BOARD_ENABLE
        help
            Board-level GPTimer upper bound for RESET press (capped at KVM_ATX_HARD_MAX_RESET_MS=200).
            TODO(hw-verify)

    config KVM_BOARD_HARD_MAX_FORCE_MS
        int "Hardware timer hard cap for ATX POWER force-off hold (ms)"
        default 5000
        range 1 5000
        depends on KVM_BOARD_ENABLE
        help
            Board-level GPTimer upper bound for FORCE hold (capped at KVM_ATX_HARD_MAX_FORCE_MS=5000).
            TODO(hw-verify)

    config KVM_BOARD_HARD_MAX_KVM_MS
        int "Hardware timer hard cap for KVM switch pulse (ms)"
        default 1000
        range 1 5000
        depends on KVM_BOARD_ENABLE
        help
            Board-level GPTimer upper bound for KVM switch optocoupler pulse (default KVM_BOARD_DEFAULT_HARD_MAX_KVM_MS=1000, cap=5000).
            TODO(hw-verify)

endmenu
