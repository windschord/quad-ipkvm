menu "KVM Board (74HC139 / ATX / KVM LED) Configuration"

    config KVM_BOARD_ENABLE
        bool "Enable KVM/ATX real GPIO board driver and start kvm_service"
        default n
        help
            Enable the real GPIO + GPTimer board HAL in components/kvm_board and start
            kvm_service on boot. Keep disabled until the 74HC139 decoders, photorelays,
            pull-ups/pull-downs, and KVM LED sense lines are wired and verified.
            TODO(hw-verify)

    config KVM_BOARD_GPIO_A0
        int "74HC139 A0 address GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            GPIO driving 74HC139 A0 (expects external 100k pull-down -> GND so reset state is CH1).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_A1
        int "74HC139 A1 address GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            GPIO driving 74HC139 A1 (expects external 100k pull-down -> GND so reset state is CH1).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_E_POWER
        int "74HC139#1 E_PWR active-low enable GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            Active-low enable for ATX POWER / POWER_FORCE (expects external 10k pull-up -> 3V3).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_E_RESET
        int "74HC139#1 E_RST active-low enable GPIO (-1 = unassigned)"
