menu "KVM Board (74HC139 / ATX / KVM LED) Configuration"

    config KVM_BOARD_ENABLE
        bool "Enable KVM/ATX real GPIO board driver and start kvm_service"
        default n
        depends on SOC_GPTIMER_SUPPORTED
        select GPTIMER_ISR_CACHE_SAFE
        select GPTIMER_CTRL_FUNC_IN_IRAM
        help
            Enable the real GPIO + GPTimer board HAL in components/kvm_board and start
            kvm_service on boot. Keep disabled until the 74HC139 decoders, photorelays,
            pull-ups/pull-downs, and KVM LED sense lines are wired and verified.
            Automatically selects GPTIMER_ISR_CACHE_SAFE and GPTIMER_CTRL_FUNC_IN_IRAM
            so the auto-release timer ISR keeps running while flash cache is disabled
            (e.g., NVS writes / OTA).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_A0
        int "74HC139 A0 address GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            GPIO driving 74HC139 A0 (expects external 100k pull-down -> GND so reset state is CH1).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_A1
        int "74HC139 A1 address GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            GPIO driving 74HC139 A1 (expects external 100k pull-down -> GND so reset state is CH1).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_E_POWER
        int "74HC139#1 E_PWR active-low enable GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            Active-low enable for ATX POWER / POWER_FORCE (expects external 10k pull-up -> 3V3).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_E_RESET
        int "74HC139#1 E_RST active-low enable GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            Active-low enable for ATX RESET (expects external 10k pull-up -> 3V3).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_E_KVM
        int "74HC139#2 E_KVM active-low enable GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            Active-low enable for KVM switch button optocoupler (expects external 10k pull-up -> 3V3).
            TODO(hw-verify)

    config KVM_BOARD_GPIO_LED_CH1
        int "KVM LED sense CH1 GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            GPIO reading KVM channel 1 LED state.
            Internal pull-up and pull-down are DISABLED; external photocoupler / open-collector
            circuit MUST provide an external pull-up (or pull-down) resistor so the input does not float.
            TODO(hw-verify)

    config KVM_BOARD_GPIO_LED_CH2
        int "KVM LED sense CH2 GPIO (-1 = unassigned)"
        default -1
        range -1 54
        depends on KVM_BOARD_ENABLE
        help
            GPIO reading KVM channel 2 LED state.
            Internal pull-up and pull-down are DISABLED; external photocoupler / open-collector
            circuit MUST provide an external pull-up (or pull-down) resistor so the input does not float.
            TODO(hw-verify)

    config KVM_BOARD_GPIO_LED_CH3
        int "KVM LED sense CH3 GPIO (-1 = unassigned)"
        default -1
        range -1 54
